variable    out_freq equal 1000
variable    out_freq2 equal 1000

timestep    2.0

neigh_modify    delay 7 every 1

include     in.tip4p
# This is TIP4P/Ice

# create groups ###
group ox type 2
288 atoms in group ox
group hy type 1
576 atoms in group hy

# set charges - beside manually ###
set group ox charge -1.1794
Setting atom values ...
  288 settings made for charge
set group hy charge 0.5897
Setting atom values ...
  576 settings made for charge

# ### TIP3P Potential Parameters ###
pair_style lj/cut/tip4p/long 2 1 1 1 0.1577 8.5
pair_coeff 1 1*2 0.000 0.000
pair_coeff 2 2 0.21084 3.1668
bond_style  harmonic
bond_coeff  1 450 0.9572
angle_style harmonic
angle_coeff 1 55 104.52
kspace_style pppm/tip4p 1.0e-4 #final npt relaxation
pair_modify tail yes

thermo          ${out_freq}
thermo          1000
thermo_style    custom step temp pe etotal epair emol press lx ly lz vol pxx pyy pzz pxy pxz pyz

restart     ${out_freq} restart.lmp restart2.lmp
restart     1000 restart.lmp restart2.lmp

dump            myDump all atom ${out_freq2} colvars/dump_159_360.water
dump            myDump all atom 1000 colvars/dump_159_360.water
dump_modify     myDump append yes

fix             1 all plumed plumedfile colvars/plumed_159_360.dat outfile plumed_out159.36
fix             2 all shake 1e-6 200 0 b 1 a 1
Finding SHAKE clusters ...
       0 = # of size 2 clusters
       0 = # of size 3 clusters
       0 = # of size 4 clusters
     288 = # of frozen angles
  find clusters CPU = 0.001 seconds
fix             3 all nph iso ${pressure} ${pressure} ${pressureDamp}
fix             3 all nph iso 1 ${pressure} ${pressureDamp}
fix             3 all nph iso 1 1 ${pressureDamp}
fix             3 all nph iso 1 1 1000
fix             4 all temp/csvr ${temperature} ${temperature} ${tempDamp} ${seed}
fix             4 all temp/csvr 300 ${temperature} ${tempDamp} ${seed}
fix             4 all temp/csvr 300 300 ${tempDamp} ${seed}
fix             4 all temp/csvr 300 300 100 ${seed}
fix             4 all temp/csvr 300 300 100 36284
velocity        all create ${temperature} ${seed} dist gaussian
velocity        all create 300 ${seed} dist gaussian
velocity        all create 300 36284 dist gaussian

run             7500000
