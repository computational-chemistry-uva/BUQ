#vim:ft=plumed
MOLINFO STRUCTURE=simulations_essentials/diala.pdb
UNITS LENGTH=A TIME=ps ENERGY=kcal/mol
phi: TORSION ATOMS=@phi-2
psi: TORSION ATOMS=@psi-2
cos_phi: MATHEVAL arg=phi FUNC=cos(x) PERIODIC=NO
sin_phi: MATHEVAL arg=phi FUNC=sin(x) PERIODIC=NO
cos_psi: MATHEVAL arg=psi FUNC=cos(x) PERIODIC=NO
sin_psi: MATHEVAL arg=psi FUNC=sin(x) PERIODIC=NO
restraint_phi_cos: MOVINGRESTRAINT ...
ARG=cos_phi
STEP0=0 AT0=-0.009746518887346676 KAPPA0=0
STEP1=1000 AT1=-0.009746518887346676 KAPPA1=400.0
STEP2=5156 AT2=-0.8443279255321985 KAPPA2=400.0
...
restraint_phi_sin: MOVINGRESTRAINT ...
ARG=sin_phi
STEP0=0 AT0=-0.9999525015567382 KAPPA0=0
STEP1=1000 AT1=-0.9999525015567382 KAPPA1=400.0
STEP2=5156 AT2=0.5358267949314353 KAPPA2=400.0
...
restraint_psi_cos: MOVINGRESTRAINT ...
ARG=cos_psi
STEP0=0 AT0=0.25614238207053525 KAPPA0=0
STEP1=1000 AT1=0.25614238207053525 KAPPA1=400.0
STEP2=1180 AT2=0.42577929182957125 KAPPA2=400.0
...
restraint_psi_sin: MOVINGRESTRAINT ...
ARG=sin_psi
STEP0=0 AT0=0.9666390640291918 KAPPA0=0
STEP1=1000 AT1=0.9666390640291918 KAPPA1=400.0
STEP2=1180 AT2=0.9048270523415559 KAPPA2=400.0
...
PRINT ARG=sin_phi,cos_phi,sin_psi,cos_psi,*.* FILE=Colvars/COLVAR_2.576_1.131 STRIDE=100
