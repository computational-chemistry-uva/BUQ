#vim:ft=plumed
MOLINFO STRUCTURE=simulations_essentials/diala.pdb
UNITS LENGTH=A TIME=ps ENERGY=kcal/mol
phi: TORSION ATOMS=@phi-2
psi: TORSION ATOMS=@psi-2
cos_phi: MATHEVAL arg=phi FUNC=cos(x) PERIODIC=NO
sin_phi: MATHEVAL arg=phi FUNC=sin(x) PERIODIC=NO
cos_psi: MATHEVAL arg=psi FUNC=cos(x) PERIODIC=NO
sin_psi: MATHEVAL arg=psi FUNC=sin(x) PERIODIC=NO
restraint_phi_cos: MOVINGRESTRAINT ...
ARG=cos_phi
STEP0=500 AT0=1.0 KAPPA0=0
STEP1=1500 AT1=1.0 KAPPA1=200.0
STEP2=4070 AT2=-0.8412535328311813 KAPPA2=200.0
...
restraint_phi_sin: MOVINGRESTRAINT ...
ARG=sin_phi
STEP0=500 AT0=0.0 KAPPA0=0
STEP1=1500 AT1=0.0 KAPPA1=200.0
STEP2=4070 AT2=0.5406408174555974 KAPPA2=200.0
...
restraint_psi_cos: MOVINGRESTRAINT ...
ARG=cos_psi
STEP0=500 AT0=1.0 KAPPA0=0
STEP1=1500 AT1=1.0 KAPPA1=200.0
STEP2=2483 AT2=0.5539200638661104 KAPPA2=200.0
...
restraint_psi_sin: MOVINGRESTRAINT ...
ARG=sin_psi
STEP0=500 AT0=0.0 KAPPA0=0
STEP1=1500 AT1=0.0 KAPPA1=200.0
STEP2=2483 AT2=0.8325698546347713 KAPPA2=200.0
...
PRINT ARG=sin_phi,cos_phi,sin_psi,cos_psi,*.* FILE=colvars/COLVAR_2.570_0.984 STRIDE=100
